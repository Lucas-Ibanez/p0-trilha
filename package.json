{
  "name": "hive-landing",
  "version": "0.0.0",
  "private": true,
  "description": "Landing page bilíngue (EN e PT-BR) da Hive",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run check",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run check:claims && npm run check:i18n && npm run check:evidence && npm run check:tokens",
    "check:claims": "node scripts/check-claims.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:evidence": "node scripts/check-evidence.mjs",
    "check:tokens": "node scripts/check-tokens.mjs"
  },
  "dependencies": {
    "next": "16.4.1",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
